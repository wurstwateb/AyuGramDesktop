[Desktop Entry]
Name=TypendruckerGram Desktop
Comment=Desktop version of TypendruckerGram - ToS breaking Telegram client
TryExec=TypendruckerGram
Exec=env DESKTOPINTEGRATION=1 TypendruckerGram -- %U
Icon=com.typendruckergram.desktop
Terminal=false
StartupWMClass=TypendruckerGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=TypendruckerGram -quit
Name=Quit TypendruckerGram
Icon=application-exit
